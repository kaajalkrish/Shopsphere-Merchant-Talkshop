# ── Copy this file to .env and fill in your values ───────────────────────────
# cp .env.example .env

# ── LLM (at least one required) ───────────────────────────────────────────────

# Gemini 2.0 Flash Lite — free tier: 30 RPM / 1500 RPD
# Get key: console.cloud.google.com → Enable "Generative Language API"
GOOGLE_API_KEY=your_google_api_key_here

# Ollama — fully local fallback, no key needed
# Setup: download from ollama.com → run: ollama pull llama3.2
# Leave blank if using Gemini
OLLAMA_BASE_URL=http://localhost:11434

# ── Merchant A — Shopify Storefront API ───────────────────────────────────────
# Setup: partners.shopify.com → create dev store → Settings → Apps → Storefront API
# Used for: RunnerWorld (shoes/apparel)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_shopify_storefront_token_here

# ── Merchant B — Best Buy Products API ────────────────────────────────────────
# Instant signup: developer.bestbuy.com → register → get key via email
# Free tier: 50,000 calls/day, 5 calls/second
# Used for: TechStore (electronics)
BESTBUY_API_KEY=your_bestbuy_api_key_here

# ── Merchant C — Local (always on, no key needed) ─────────────────────────────
# SQLite + seeded JSON data — FashionHub (accessories)
# No credentials required

# ── App settings ──────────────────────────────────────────────────────────────
# Product catalogs search reads (comma-separated): shopsphere, shopify, bestbuy, dummyjson
# Demo 1 = shopsphere only. Note: the dummyjson adapter currently drops every
# item (see docs/demo-1-shopsphere-talkshop-plan.md, Known issues).
CATALOG_SOURCES=shopsphere
DEMO_MODE=true
DATABASE_URL=sqlite:///./backend/db/commerce.db
FRONTEND_URL=http://localhost:5173

# ── Cloud deployment (Render backend + Vercel frontend; see README "Live demo") ──
# Backend (Render dashboard). Unset locally.
# FRONTEND_ORIGINS=https://your-frontend.vercel.app   # CORS + who may embed the provider page (comma-separated)
# CORS_ORIGINS=                                       # optional extra CORS origins (comma-separated, never *)
# PUBLIC_BACKEND_URL=                                 # backend's public URL; on Render RENDER_EXTERNAL_URL is used
# COMMERCE_DB_PATH=/tmp/shopsphere-demo.db            # SQLite file (ephemeral on Render)
# OTEL_SDK_DISABLED=true                              # no trace collector in the cloud
# JWT_SECRET_KEY= / SIGNING_KEY= / MOCK_GATEWAY_KEY=  # random values in production (Render generates them)
# Frontend (Vercel dashboard), read at build time:
# VITE_API_BASE_URL=https://your-backend.onrender.com
